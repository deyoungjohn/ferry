{
  "name": "ferry",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.9",
  "description": "Ferry: trust-minimised stablecoin swaps between Bitcoin Cash and EVM chains.",
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "build": "pnpm -r --if-present build",
    "test": "pnpm -r --if-present test",
    "typecheck": "pnpm -r --workspace-concurrency=6 --if-present typecheck",
    "lint": "pnpm lint:root && pnpm -r --workspace-concurrency=6 --if-present lint",
    "lint:root": "eslint --cache *.mjs *.ts eslint-rules test scripts",
    "test:unit": "vitest run --maxWorkers=6 --no-isolate",
    "check:private": "node scripts/guard/private-refs.mjs --tree --history",
    "format": "prettier --cache --write .",
    "format:check": "prettier --cache --check .",
    "typecheck:changed": "pnpm --filter \"...[origin/main]\" --workspace-concurrency=6 --if-present typecheck",
    "lint:changed": "pnpm --filter \"...[origin/main]\" --workspace-concurrency=6 --if-present lint",
    "test:changed": "pnpm --filter \"...[origin/main]\" --if-present test",
    "fast:typecheck": "turbo run typecheck",
    "fast:lint": "turbo run lint",
    "fast:test": "turbo run test",
    "verify:mutation": "node scripts/verify/run-mutation.mjs",
    "verify:heavy": "node scripts/verify/run-heavy.mjs"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@stryker-mutator/core": "10.1.1",
    "@stryker-mutator/vitest-runner": "10.1.1",
    "@types/node": "22.20.5",
    "@vitest/coverage-v8": "5.0.5",
    "eslint": "10.13.0",
    "prettier": "3.9.10",
    "tsx": "4.23.15",
    "turbo": "2.11.10",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.0",
    "vitest": "5.0.5"
  }
}
