{
  "$schema": "https://turbo.build/schema.json",
  "ui": "stream",
  "tasks": {
    "typecheck": {
      "inputs": ["$TURBO_DEFAULT$", "!**/*.md", "!**/*.tsbuildinfo"],
      "outputs": ["*.tsbuildinfo"]
    },
    "lint": {
      "inputs": ["$TURBO_DEFAULT$", "!**/*.md"],
      "outputs": [".eslintcache"]
    },
    "test": {
      "inputs": ["$TURBO_DEFAULT$", "!**/*.md"],
      "outputs": ["coverage/**"]
    }
  }
}
