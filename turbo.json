{
  "$schema": "https://turbo.build/schema.json",
  "ui": "stream",
  "tasks": {
    "typecheck": {
      "inputs": ["$TURBO_DEFAULT$", "!**/*.md", "!**/*.tsbuildinfo"],
      "outputs": ["*.tsbuildinfo"],
      "dependsOn": ["^typecheck"]
    },
    "lint": {
      "inputs": ["$TURBO_DEFAULT$", "!**/*.md"],
      "outputs": [".eslintcache"],
      "dependsOn": ["^lint"]
    },
    "test": {
      "inputs": ["$TURBO_DEFAULT$", "!**/*.md"],
      "outputs": ["coverage/**"],
      "dependsOn": ["^test"]
    }
  }
}
