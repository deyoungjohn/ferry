# Ferry production Caddyfile.
# Replace example.org with ferry.incepture.dev, or set FERRY_DOMAIN.
# The solver listens on localhost only; Caddy is the single public origin.
# The SPA fallback covers /swap/<hash>, /pay/<hash>, /send/<hash> and /features.

{$FERRY_DOMAIN:example.org} {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
		X-Frame-Options "DENY"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "accelerometer=(), camera=(), geolocation=(), gyroscope=(), magnetometer=(), microphone=(), payment=(), usb=()"
		Content-Security-Policy "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self' https://*.walletconnect.com https://*.walletconnect.org https://*.reown.com https://api.web3modal.org https://rpc.walletconnect.org https://pulse.walletconnect.org wss://*.walletconnect.com wss://*.walletconnect.org wss://*.reown.com wss://bch.imaginary.cash:50004 wss://blackie.c3-soft.com:50004 https://mainnet.base.org https://base-rpc.publicnode.com https://ethereum-rpc.publicnode.com https://bsc-rpc.publicnode.com https://arb1.arbitrum.io https://arbitrum.gateway.tenderly.co https://1rpc.io https://rpc.flashbots.net; frame-src 'self' https://verify.walletconnect.com https://verify.walletconnect.org; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none';"
	}

	header /v1/* Cache-Control "no-store"

	# One origin: the web app calls /v1/* on this same host.
	handle /v1/* {
		reverse_proxy 127.0.0.1:8787
	}

	handle {
		root * /var/www/ferry/dist
		try_files {path} /index.html
		file_server
	}

	@hashedAssets path /assets/*
	header @hashedAssets Cache-Control "public, max-age=31536000, immutable"

	# The standalone recovery page is one file with its own inline script, so it needs a different
	# policy from the app. It can reach only public blockchain servers.
	@recoverPage path /recover.html
	header @recoverPage {
		>Content-Security-Policy "default-src 'none'; script-src 'unsafe-inline' 'wasm-unsafe-eval'; style-src 'unsafe-inline'; connect-src https: wss:; img-src data:"
		Cache-Control "no-cache"
	}

	@staticFiles path /favicon.svg /robots.txt /glass/*
	header @staticFiles Cache-Control "public, max-age=86400"

	@htmlEntry path /index.html /
	header @htmlEntry {
		Cache-Control "no-cache, no-store, must-revalidate"
		Pragma "no-cache"
		Expires "0"
	}

	# Access logs keep only the network prefix, never the full client address.
	log {
		output file /var/log/caddy/ferry-access.log {
			mode 0640
			roll_size 50MiB
			roll_keep 5
		}
		format filter {
			wrap json
			fields {
				request>remote_ip ip_mask {
					ipv4 24
					ipv6 56
				}
				request>client_ip ip_mask {
					ipv4 24
					ipv6 56
				}
				request>headers>X-Forwarded-For delete
				common_log delete
			}
		}
	}
}
