# Ferry production Caddyfile.
# Replace example.org with ferry.incepture.dev, or set FERRY_DOMAIN.
# The solver listens on localhost only; Caddy is the single public origin.
# /          -> the maintainer's landing build in /var/www/ferry/landing
# /swap/*    -> the Ferry app build in /var/www/ferry/swap
# /v1/*      -> the solver on 127.0.0.1:8787

{$FERRY_DOMAIN:example.org} {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
		X-Frame-Options "DENY"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "accelerometer=(), camera=(), geolocation=(), gyroscope=(), magnetometer=(), microphone=(), payment=(), usb=()"
	}

	header /v1/* Cache-Control "no-store"

	# The app has a strict CSP. The landing page is the maintainer's content:
	# set a separate, looser Content-Security-Policy for the landing matcher
	# below rather than weakening this app policy.
	@swap path /swap/*
	header @swap {
		Content-Security-Policy "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self' https://*.walletconnect.com https://*.walletconnect.org https://*.reown.com https://api.web3modal.org https://rpc.walletconnect.org https://pulse.walletconnect.org wss://*.walletconnect.com wss://*.walletconnect.org wss://*.reown.com; frame-src 'self' https://verify.walletconnect.com https://verify.walletconnect.org; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none';"
	}
	# @landing not path /swap/* /v1/*
	# header @landing {
	#   Content-Security-Policy "<maintainer sets the landing policy here>"
	# }

	redir /swap /swap/ 308

	# API first: this handler must stay before the static catch-all.
	handle /v1/* {
		reverse_proxy 127.0.0.1:8787
	}

	handle /swap/* {
		root * /var/www/ferry
		try_files {path} /swap/index.html
		file_server
	}

	handle {
		root * /var/www/ferry/landing
		try_files {path} /index.html
		file_server
	}

	@swapHashedAssets path /swap/assets/*
	header @swapHashedAssets Cache-Control "public, max-age=31536000, immutable"

	@landingHashedAssets path /assets/*
	header @landingHashedAssets Cache-Control "public, max-age=31536000, immutable"

	@staticFiles path /favicon.svg /robots.txt /glass/*
	header @staticFiles Cache-Control "public, max-age=86400"

	@swapEntry path /swap /swap/ /swap/index.html
	header @swapEntry {
		Cache-Control "no-cache, no-store, must-revalidate"
		Pragma "no-cache"
		Expires "0"
	}

	@landingEntry path / /index.html
	header @landingEntry {
		Cache-Control "no-cache, no-store, must-revalidate"
		Pragma "no-cache"
		Expires "0"
	}

	# Access logs keep only the network prefix, never the full client address.
	log {
		output file /var/log/caddy/ferry-access.log {
			mode 0640
			roll_size 50MiB
			roll_keep 5
		}
		format filter {
			wrap json
			fields {
				request>remote_ip ip_mask {
					ipv4 24
					ipv6 56
				}
				request>client_ip ip_mask {
					ipv4 24
					ipv6 56
				}
				request>headers>X-Forwarded-For delete
				common_log delete
			}
		}
	}
}
