[Unit]
Description=Ferry HTTP health check
After=ferry-solver.service

[Service]
Type=oneshot
User=ferry
Group=ferry
ExecStart=/usr/local/sbin/ferry-healthcheck
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
LockPersonality=true
