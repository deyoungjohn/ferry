{
  "name": "@ferry/preflight",
  "private": true,
  "type": "module",
  "scripts": {
    "preflight": "pnpm --dir ../.. --filter @ferry/chain-config preflight",
    "watch-chains": "pnpm --dir ../.. --filter @ferry/chain-config watch-chains",
    "measure-rpc": "pnpm --dir ../.. --filter @ferry/chain-config measure-rpc",
    "deploy-funding": "node --conditions=ferry-source --import tsx deploy-funding.ts",
    "typecheck": "pnpm --dir ../.. exec tsc --noEmit -p scripts/preflight/tsconfig.json"
  }
}
