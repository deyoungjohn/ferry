{
  "name": "@ferry/solver",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "ferry-source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsx --conditions=ferry-source src/dev.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint --cache src test",
    "start": "node dist/main.js",
    "test": "vitest run --config vitest.config.ts"
  },
  "dependencies": {
    "@bitauth/libauth": "3.0.0",
    "@fastify/cors": "11.3.1",
    "@ferry/bch-prices": "workspace:*",
    "@ferry/chain-config": "workspace:*",
    "@ferry/chain-evm": "workspace:*",
    "@ferry/core": "workspace:*",
    "@ferry/htlc-bch": "workspace:*",
    "better-sqlite3": "13.0.3",
    "cashscript": "0.14.0",
    "fastify": "5.12.7",
    "pino": "10.4.0",
    "viem": "2.57.10",
    "ws": "8.22.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@ferry/solver-client": "workspace:*",
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "22.20.5",
    "@types/ws": "8.18.2",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "5.0.5"
  }
}
