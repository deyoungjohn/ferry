# Network profile: testnet | mainnet
NETWORK=

# Server HTTP bind host and port
HOST=
PORT=

# SQLite database file path (e.g. data/solver.db or :memory:)
DATABASE_PATH=

# CORS allowed origins (comma-separated origins, or * for all)
ALLOWED_ORIGINS=

# Reverse proxy trust setting (1 / true if behind reverse proxy e.g. Caddy/Nginx)
TRUSTED_PROXY=

# Structured logging level: trace | debug | info | warn | error | fatal
LOG_LEVEL=

# Optional log file destination for structured file logging with automatic rotation
LOG_FILE_PATH=

# Constant-time Bearer token for accessing /v1/operator/* routes (>= 32 chars on mainnet)
OPERATOR_TOKEN=

# Quoting kill switch: true | false
QUOTING_ENABLED=

# Bitcoin Cash Electrum WebSocket endpoints (comma-separated; >= 2 hosts on mainnet)
BCH_ELECTRUM_URLS=
BCH_CHIPNET_ELECTRUM_URLS=

# Solver private keys (never commit or print real values)
SOLVER_BCH_WIF=
SOLVER_EVM_PRIVATE_KEY=
ALLOW_DEV_KEYS=

# EVM & Multi-chain configuration
# Every enabled chain's RPC list, HTLC address, and token addresses are
# automatically configured from @ferry/chain-config facts without requiring
# one environment block per chain. Optional RPC overrides per chain:
RPC_URL_BASE=
RPC_URL_ETHEREUM=
RPC_URL_ARBITRUM=
RPC_URL_BNB=
RPC_URL_ARC=
RPC_URL_ROBINHOOD=

# Base environment overrides (optional fallback)
BASE_RPC_URL=
BASE_CHAIN_ID=
BASE_FERRY_HTLC_ADDRESS=
BASE_USDC_ADDRESS=

# Enabled routes override from chain-config (e.g. USDC:base,USDC:ethereum)
ENABLED_ROUTES=

# Double-spend proof window in milliseconds (default: 5000)
DSPROOF_WINDOW_MS=

# Chain tip staleness limits in seconds
TIP_MAX_AGE_BCH_SECONDS=
TIP_MAX_AGE_BASE_SECONDS=

# Rate limiting parameters for public quote & link routes
RATE_LIMIT_WINDOW_MS=
RATE_LIMIT_MAX_PER_ADDRESS=
RATE_LIMIT_MAX_PER_IP=

# Pricing & fees policy
SPREAD_BPS=
FIXED_FEE_USD_MICROS=
MIN_SWAP_USD_MICROS=
MAX_SWAP_USD_MICROS=
MAX_EXPOSURE_USD_MICROS=
ZERO_CONF_MAX_USD_MICROS=
QUOTE_TTL_SECONDS=
SKEW_MAX_BPS=

# Swap confirmation & refund timings
EVM_CONFS=
FWD_BCH_REFUND_BLOCKS=
FWD_EVM_DEADLINE_SECONDS=
REV_BCH_REFUND_BLOCKS=
REV_EVM_DEADLINE_SECONDS=
BCH_CARRY_SATS=
BCH_MAX_FEE_SATS=

# CashTokens category IDs for testnet
TPUSD_CATEGORY=
TMUSD_CATEGORY=

# Test mock signature flag (forbidden on mainnet)
ALLOW_MOCK_PAYLINK_SIGNATURES=
