{
  "name": "@ferry/chain-config",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Verified EVM chain and stablecoin facts with a fail-closed route configuration.",
  "exports": {
    ".": {
      "ferry-source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && mkdir -p dist/data && cp src/data/chains.json dist/data/chains.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src test",
    "test": "vitest run --config vitest.config.ts",
    "verify": "tsx src/verify.ts"
  },
  "dependencies": {
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "5.0.5"
  }
}
