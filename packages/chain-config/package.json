{
  "name": "@ferry/chain-config",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Verified EVM chain and stablecoin facts with a fail-closed route configuration.",
  "exports": {
    ".": {
      "ferry-source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && mkdir -p dist/data && cp src/data/chains.json dist/data/chains.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint --cache src test",
    "test": "vitest run --config vitest.config.ts",
    "verify": "node --conditions=ferry-source --import tsx src/verify.ts",
    "preflight": "node --conditions=ferry-source --import tsx src/preflight.ts",
    "watch-chains": "node --conditions=ferry-source --import tsx src/watch-chains.ts",
    "measure-rpc": "node --conditions=ferry-source --import tsx src/measure-rpc.ts",
    "record-deployment": "node --conditions=ferry-source --import tsx src/record-deployment.ts",
    "bch-servers": "node --conditions=ferry-source --import tsx src/bch-servers.ts"
  },
  "dependencies": {
    "@ferry/core": "workspace:*",
    "viem": "2.57.10",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "5.0.5",
    "@ferry/htlc-bch": "workspace:*"
  }
}
