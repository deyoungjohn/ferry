{
  "name": "@ferry/htlc-evm",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Ferry EVM HTLC contract, ABI and deterministic deploy script",
  "exports": {
    "./abi": "./abi.ts"
  },
  "scripts": {
    "build": "forge build",
    "test": "forge test && node scripts/check-abi.mjs && vitest run",
    "snapshot": "forge snapshot",
    "abi": "node scripts/export-abi.mjs",
    "typecheck": "tsc --noEmit && node --check scripts/export-abi.mjs && node --check scripts/check-abi.mjs",
    "lint": "forge fmt --check && eslint --cache .",
    "slither": "slither . --filter-paths 'node_modules|lib|test|script'",
    "deploy-htlc": "tsx --conditions=ferry-source scripts/deploy.ts",
    "verify-commands": "tsx --conditions=ferry-source scripts/verify-commands.ts"
  },
  "devDependencies": {
    "@ferry/chain-config": "workspace:*",
    "@ferry/core": "workspace:*",
    "@openzeppelin/contracts": "5.6.1",
    "forge-std": "github:foundry-rs/forge-std#v1.9.7",
    "tsx": "4.23.15",
    "viem": "2.57.20"
  }
}
