{
  "name": "@ferry/recover-page",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "One self-contained page that recovers a swap from its recovery file without Ferry's website or any solver",
  "scripts": {
    "build": "node scripts/build.mjs",
    "check": "node scripts/build.mjs --check",
    "typecheck": "tsc --noEmit",
    "lint": "eslint --cache src test",
    "test": "vitest run --config vitest.config.ts"
  },
  "dependencies": {
    "@ferry/chain-config": "workspace:*",
    "@bitauth/libauth": "3.0.0",
    "@ferry/core": "workspace:*",
    "@ferry/htlc-bch": "workspace:*",
    "@ferry/htlc-evm": "workspace:*",
    "viem": "2.57.10"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "esbuild": "0.28.2",
    "typescript": "5.9.3",
    "vitest": "5.0.5",
    "playwright-core": "1.50.1",
    "ws": "8.22.0",
    "@types/ws": "8.18.2"
  }
}
