# Network Profile: set to 'mainnet' for production builds, or omit/testnet for test environments
VITE_NETWORK=

# Solver API Endpoints (comma-separated origins)
VITE_SOLVER_URLS=

# Reown AppKit / WalletConnect Project ID for EVM wallet connectivity
VITE_REOWN_PROJECT_ID=

# Mock Mode: set to '1' only for offline mock simulation; keep empty for production
VITE_MOCK=

# Banner Configuration:
# The repository URL has a default (https://github.com/deyoungjohn/ferry),
# but the maintainer must configure the following exact variables for production:
VITE_DECK_URL=
VITE_EMBER_ADDRESS=
# Prior work repository (required) and optional demo/recording URL:
VITE_PRIOR_REPO_URL=
# Optional: pre-event version ran locally; recording URL if available
VITE_PRIOR_DEMO_URL=
VITE_REPO_URL=
VITE_LICENSE_URL=

# Custom WizardConnect Relay URLs (comma-separated list of WebSocket endpoints)
# Off by default. When unset or empty, WizardConnect defaults to:
# wss://relay.riften.net:443, wss://relay.cauldron.quest:443
# Example to test your own relay: VITE_WIZARD_RELAY_URLS=wss://relay.example.com:443
VITE_WIZARD_RELAY_URLS=
