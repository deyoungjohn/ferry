# Ferry environment names. Copy to .env.local (gitignored) and fill values.
# Never commit a real RPC URL, key, mnemonic or WIF.
# Do not load this file wholesale; export only the RPC_URL_* lines for preflight.

# Read-only preflight overrides. Comma-separated http(s) URLs.
# The first URL for a chain is used before the public URLs in chain-config.
# The value is never printed; logs show the host name only.
RPC_URL_BASE=
RPC_URL_ETHEREUM=
RPC_URL_ARBITRUM=
RPC_URL_ARC=
RPC_URL_BNB=
RPC_URL_ROBINHOOD=

# Read-only preflight addresses. Labels make the roles explicit:
# PREFLIGHT_ADDRESSES=deployer=0x...,solver=0x...,bch=bitcoincash:...
# Unlabelled EVM and CashAddr entries are also accepted.
PREFLIGHT_ADDRESSES=

# Bitcoin Cash Fulcrum endpoints for the preflight. Mainnet needs two hosts.
# Surveyed 2026-11-16; all reachable hosts returned the same tip and mainnet genesis.
# Recommended three (Germany, Denmark, United States):
# BCH_ELECTRUM_URLS=wss://electron.jochen-hoenicke.de:51004,wss://electroncash.dk:50004,wss://bch.imaginary.cash:50004
# Backup: wss://cashnode.bch.ninja:443
# Unreachable at baseline: wss://bch.loping.net:50004, wss://electrumx-bch.cryptonermal.net:50004
BCH_ELECTRUM_URLS=
# BCH_CHIPNET_ELECTRUM_URLS=wss://host-one:50004,wss://host-two:64004
BCH_CHIPNET_ELECTRUM_URLS=
# The configured network genesis hash; the preflight refuses a mismatch.
BCH_GENESIS_HASH=
# CashToken categories for PUSD and MUSD (display order).
PUSD_CATEGORY=
MUSD_CATEGORY=
